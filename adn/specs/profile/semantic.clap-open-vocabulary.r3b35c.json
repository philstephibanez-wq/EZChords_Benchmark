{
  "schema": "ezstudio.gene-spec.v1",
  "gene": {
    "id": "semantic.clap-open-vocabulary",
    "name": "CLAP Open Vocabulary",
    "region": "profile",
    "revision": "r3b35c-compat-v1"
  },
  "engine": {
    "adapter": "clap-zero-shot",
    "model": "laion/clap-htsat-unfused",
