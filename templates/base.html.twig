<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}EZChords Benchmark{% endblock %}</title>
<style>
body{font-family:Arial,sans-serif;margin:0;background:#f3f3f3;color:#111}
header{background:#222;color:#fff;padding:12px 20px}
header a{color:#fff;text-decoration:none}
.header-inner{max-width:1700px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:18px}
.main-nav{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.main-nav a{padding:6px 10px;border:1px solid #666;border-radius:3px;background:#2c2c2c}
.main-nav a:hover,.main-nav a:focus{background:#444}
.review-check{display:flex!important;flex-direction:row!important;align-items:center;gap:6px!important;white-space:nowrap}
.trash-button{border:0;background:transparent;font-size:20px;line-height:1;padding:4px 7px;cursor:pointer}
.trash-button:hover,.trash-button:focus{background:#eee}
.display-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.display-controls label{display:flex;flex-direction:row;gap:6px;align-items:center}
.volume-control{display:flex!important;flex-direction:row!important;align-items:center;gap:6px!important}
.volume-control input[type=range]{width:120px;padding:0}


.wrap{max-width:1700px;margin:18px auto;padding:0 16px}
.card{background:#fff;border:1px solid #bbb;padding:14px;margin-bottom:16px}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:end}
label{display:flex;flex-direction:column;gap:5px}
input,select,button{font:inherit;padding:7px}
button{cursor:pointer}
table{width:100%;border-collapse:collapse;background:#fff}
th,td{border:1px solid #bbb;padding:7px;text-align:left}
a.song{font-weight:bold;color:#111}
.timeline-line{display:grid;grid-template-columns:210px minmax(0,1fr) 170px;gap:10px;align-items:center;margin:10px 0}
.algo-name{font-weight:bold}
.timeline{display:flex;overflow-x:auto;border:1px solid #444;background:#fff;height:42px}
.measure{min-width:88px;border-right:1px solid #aaa;padding:3px 6px;box-sizing:border-box;font:13px Consolas,monospace;white-space:nowrap}
.measure .n{display:block;font:9px Arial,sans-serif;color:#777}
.choice{display:flex;gap:12px;align-items:center}
.choice label{display:flex;flex-direction:row;align-items:center;gap:4px}
.meta{color:#666;font-size:12px}
.score{font-weight:bold}
@media(max-width:900px){.timeline-line{grid-template-columns:1fr}.choice{margin-bottom:8px}}

.player-panel{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.player-panel audio{min-width:min(620px,100%);max-width:100%}
.player-state{font-size:12px;color:#666;min-width:170px}
.timeline-line{grid-template-columns:205px minmax(0,1fr) 185px}
.timeline{height:58px;scrollbar-width:thin;scroll-behavior:smooth}
.measure{min-width:auto;padding:0;border-right:2px solid #555;display:flex;flex-direction:column}
.measure .n{height:16px;padding:2px 6px;box-sizing:border-box;background:#eee;border-bottom:1px solid #bbb}
.beats{display:flex;height:41px}
.beat{min-width:68px;padding:9px 8px 6px;box-sizing:border-box;border-right:1px solid #ccc;font:15px Consolas,monospace;text-align:center;white-space:nowrap;position:relative}
.beat:last-child{border-right:0}
.beat.current{outline:3px solid #111;outline-offset:-3px;background:#e8e8e8;font-weight:bold}
.measure.current-measure>.n{background:#d8d8d8;font-weight:bold}
.algo-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.listen-button{padding:5px 9px}
.listen-radio{display:flex;flex-direction:row;gap:5px;align-items:center}
.meta{white-space:nowrap}
.choice{justify-content:flex-end}
@media(max-width:1100px){
  .timeline-line{grid-template-columns:180px minmax(0,1fr) 165px}
  .beat{min-width:62px}
  .meta{white-space:normal}
}

</style>
</head>
<body>
<header>
<div class="header-inner">
<a href="{{ path('bench_index') }}"><b>EZChords Benchmark</b></a>
<nav class="main-nav" aria-label="Navigation principale">
<a href="{{ path('bench_index') }}#analyser">Analyser</a>
<a href="{{ path('bench_index') }}#chansons">Chansons</a>
<a href="{{ path('bench_index') }}#scores">Scores</a>
<a href="{{ path('bench_report') }}">Bilan</a>
</nav>
</div>
</header>
<div class="wrap">{% block body %}{% endblock %}</div>
</body>
</html>
