{% extends 'base.html.twig' %}
{% block title %}{{ run.title }} · EZChords Benchmark{% endblock %}
{% block body %}

<div class="card">
<h1>{{ run.title }}{% if run.artist %} — {{ run.artist }}{% endif %}</h1>
<div class="meta">
Signature : {{ run.detected_signature ?: run.requested_signature }}
· Tempo : {{ run.tempo ? run.tempo|number_format(3) ~ ' BPM' : '—' }}
</div>
{% if meter_diagnostic %}
<div class="meta" style="margin-top:6px">
Auto métrique :
initiale {{ meter_diagnostic.initial_signature ?? meter_diagnostic.signature }}
→ utilisée {{ meter_diagnostic.signature }}
{% if meter_diagnostic.duple_refinement is defined and meter_diagnostic.duple_refinement.applied %}
· Δ(4/4−2/4) BeatThis = {{ meter_diagnostic.duple_refinement.delta_4_minus_2|number_format(5) }}
{% endif %}
</div>
{% endif %}
{% if convergence %}
<div class="meta" style="margin-top:4px">
Convergence : {{ convergence.distinct_phases }} phase(s) distincte(s)
{% if convergence.unanimous %}· <b>unanimité des 6 méthodes</b>{% endif %}
</div>
{% endif %}
{% if silence_diagnostic %}
<div class="meta" style="margin-top:4px">
No-chord : <b>{{ silence_diagnostic.silent_beats }}</b>/{{ silence_diagnostic.total_beats }} beats
· RMS seuil {{ silence_diagnostic.rms_threshold_db|number_format(1) }} dB
</div>
{% endif %}
</div>

<div class="card">
<h2>Lecture synchronisée <span style="font-size:12px;color:#777;font-weight:normal">Player V6b</span></h2>
<div class="player-panel">
<label style="display:flex;flex-direction:row;align-items:center;gap:6px">
<input type="checkbox" id="mp3-enabled" {% if audio_available %}checked{% else %}disabled{% endif %}>
MP3 original{% if not audio_available %} — absent{% endif %}
</label>

<button type="button" id="master-play">▶ Lire</button>
<button type="button" id="master-stop">■ Stop</button>
<button type="button" id="audio-test">Test piano</button>

<label class="volume-control">
MP3
<input type="range" id="mp3-volume" min="0" max="100" value="100">
<span id="mp3-volume-value">100%</span>
</label>

<label class="volume-control">
MIDI
<input type="range" id="midi-volume" min="0" max="100" value="80">
<span id="midi-volume-value">80%</span>
</label>

{% if audio_available %}
<audio id="master-audio" preload="metadata" controls controlsList="nodownload" src="{{ audio_url }}"></audio>
{% else %}
<audio id="master-audio" preload="metadata" controls></audio>
{% endif %}

<div class="player-state" id="player-state">
{% if audio_available %}MP3 prêt à charger.{% else %}Lecture accords seule disponible.{% endif %}
</div>
<div class="player-state" id="synth-state">Synthé : non initialisé</div>
</div>
</div>

<div class="card">
<div class="display-controls">
<strong>Complexité des accords affichés</strong>
<select id="chord-display-level" aria-label="Complexité des accords">
<option value="beginner">Débutant</option>
<option value="intermediate" selected>Intermédiaire</option>
<option value="advanced">Confirmé</option>
</select>
<span class="meta">La timeline et le piano virtuel utilisent immédiatement ce niveau. L'analyse brute reste inchangée.</span>
</div>
</div>

<div class="card">
<form action="{{ path('bench_review',{id:run.id}) }}" method="post">

{% for a in algorithms %}
<div class="timeline-line" data-algo-row="{{ loop.index0 }}" data-algo-name="{{ a.algorithm|e('html_attr') }}">
<div>
<div class="algo-name">{{ a.algorithm }}</div>
<div class="meta">P{{ a.phase }} · S {{ a.score|number_format(5) }} · M {{ a.margin|number_format(5) }}</div>
{% set ps = phase_diagnostics[a.algorithm] ?? [] %}
{% if ps %}
<div class="meta">
{% for p in ps %}
P{{ p.phase }}={{ p.score|number_format(4) }}{% if not loop.last %} · {% endif %}
{% endfor %}
</div>
{% endif %}
<div class="algo-tools">
<label class="listen-radio">
<input type="radio" name="listen_algo" value="{{ loop.index0 }}" {% if loop.first %}checked{% endif %}>
Écouter
</label>
<button type="button" class="listen-button" data-play-algo="{{ loop.index0 }}">▶</button>
</div>
</div>

<div class="timeline" data-timeline="{{ loop.index0 }}">
{% for m in a.grid %}
<div class="measure" data-measure="{{ m.measure }}" data-start="{{ m.start_s is defined and m.start_s is not null ? m.start_s : '' }}">
<span class="n">M{{ '%02d'|format(m.measure) }}</span>
<div class="beats">
{% for chord in m.text|trim|split(' ') %}
{% if chord != '' %}
<div class="beat" data-token="{{ chord|e('html_attr') }}"><span class="chord-label">{{ chord }}</span></div>
{% endif %}
{% endfor %}
</div>
</div>
{% endfor %}
</div>

<div class="choice">
<label class="review-check">
<input type="checkbox" name="approved[]" value="{{ a.algorithm }}"
{% if a.review_status == 'approved' %}checked{% endif %}>
Bon
</label>
<span class="meta">
{% if a.review_status == 'approved' %}approuvé{% elseif a.review_status == 'rejected' %}pas bon{% else %}non revu{% endif %}
</span>
</div>
</div>
{% endfor %}

<div class="row" style="margin-top:18px">
<label>Référence
<input name="reference" value="{{ review ? review.reference : 'Riffstation' }}">
</label>
<label style="flex:1">Commentaire
<input name="comment" value="{{ review ? review.comment : '' }}">
</label>
<button type="submit">Enregistrer</button>
</div>

</form>
</div>

<script>
window.EZCHORDS_AUDIO_AVAILABLE = {{ audio_available ? 'true' : 'false' }};
</script>
<script src="/js/benchmark-player.js?v=5"></script>

{% endblock %}
