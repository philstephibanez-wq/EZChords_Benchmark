{% extends 'base.html.twig' %}
{% block title %}PROFILE · EZStudio_lab{% endblock %}
{% block body %}
<div class="card hero"><div><h1>PROFILE</h1><div class="meta">Région PROFILE du chromosome : caractérisation globale du master avant STEMS.</div></div></div>
{% include 'workbench/_song_selector.html.twig' %}

{% if selected_song %}
<div class="card">
<div class="hero">
<div><h2>{{ selected_song.title }}{% if selected_song.artist %} — {{ selected_song.artist }}{% endif %}</h2><div class="meta">PROFILE ne lance jamais STEMS automatiquement.</div></div>
<form method="post" action="{{ path('profile_analyze') }}"><input type="hidden" name="song" value="{{ selected_song.id }}"><button type="submit">Analyser le profil</button></form>
</div>
</div>

{% if profile_runs %}
<div class="card"><form method="get" action="{{ path('workbench_profile') }}" class="row"><input type="hidden" name="song" value="{{ selected_song.id }}"><label>Run PROFILE<select name="run" onchange="this.form.submit()">{% for r in profile_runs %}<option value="{{ r.id }}" {{ selected_profile_run and r.id == selected_profile_run.id ? 'selected' : '' }}>{{ r.public_id }} · {{ r.state }} · {{ r.created_at }}</option>{% endfor %}</select></label></form></div>
{% endif %}

{% if selected_profile_run %}
  {% set job_status = profile_job and profile_job.status is defined ? profile_job.status : selected_profile_run.state %}
  {% set profile_percent = profile_job and profile_job.progress is defined ? profile_job.progress : (selected_profile_run.labels.progress ?? 0) %}
  {% set profile_active = job_status in ['queued','running','cancel_requested'] or selected_profile_run.state in ['queued','running'] %}

  {% if job_status == 'queued' %}
    <div class="card">
      <h2>PROFILE en attente</h2>
      <div class="meta">Job #{{ profile_job.id ?? '—' }} · en attente dans la queue orchestrator · {{ profile_percent }}%</div>
      <progress value="{{ profile_percent }}" max="100" style="width:100%;height:18px">{{ profile_percent }}%</progress>
    </div>
  {% elseif job_status in ['running','cancel_requested'] %}
    <div class="card">
      <h2>Progression PROFILE</h2>
      <div class="meta" style="margin-bottom:5px">Job #{{ profile_job.id ?? '—' }} · {{ job_status }} · {{ profile_percent }}%</div>
      <progress value="{{ profile_percent }}" max="100" style="width:100%;height:18px">{{ profile_percent }}%</progress>
    </div>
  {% elseif job_status in ['failed','cancelled'] or selected_profile_run.state == 'error' %}
    <div class="card">
      <h2>PROFILE en erreur</h2>
      <div class="meta">{{ profile_job.error ?? selected_profile_run.labels.last_error ?? 'Erreur non détaillée.' }}</div>
    </div>
  {% endif %}

{% set p = selected_profile_run.metrics %}
{% set t = selected_profile_run.diagnostics.tagging ?? {} %}
<div class="card"><h2>Caractéristiques</h2><div class="kv">
<div>État</div><div><span class="badge {{ selected_profile_run.state == 'done' ? 'ok' : (selected_profile_run.state == 'error' ? 'warn' : '') }}">{{ selected_profile_run.state }}</span></div>
<div>Tempo</div><div>{% if p.tempo.bpm is defined %}{{ p.tempo.bpm|number_format(2) }} BPM{% else %}—{% endif %}</div>
<div>Signature</div><div>{% if p.time_signature.label is defined and p.time_signature.label %}{{ p.time_signature.label }} · {{ (p.time_signature.confidence * 100)|number_format(0) }}%{% elseif p.time_signature.suggested_label is defined and p.time_signature.suggested_label %}Indéterminée · suggestion {{ p.time_signature.suggested_label }} · {{ (p.time_signature.confidence * 100)|number_format(0) }}%{% else %}Indéterminée{% endif %}</div>
<div>Tonalité</div><div>{% if p.key.label is defined and p.key.label %}{{ p.key.label }} · {{ (p.key.confidence * 100)|number_format(0) }}%{% else %}—{% endif %}</div>
<div>Durée</div><div>{% if p.duration_seconds is defined %}{{ p.duration_seconds|number_format(1) }} s{% else %}—{% endif %}</div>
</div></div>

{% if profile_summary %}
<div class="card profile-summary">
  <h2>Résumé français</h2>
  <p style="font-size:14px;line-height:1.55;margin:0 0 12px">{{ profile_summary.text }}</p>
  <div class="summary-grid">
    <div><span>Tempo</span><strong>{% if profile_summary.tempo_bpm is not null %}{{ profile_summary.tempo_bpm|number_format(0) }} BPM · {{ profile_summary.tempo_qualifier }}{% else %}—{% endif %}</strong></div>
    <div><span>Signature</span><strong>{{ profile_summary.meter ?? '—' }}</strong></div>
    <div><span>Tonalité</span><strong>{{ profile_summary.key ?? '—' }}</strong></div>
    <div><span>AudioSet retenu</span><strong>{{ profile_summary.audioset_accepted ? profile_summary.audioset_accepted|join(', ') : '—' }}</strong></div>
  </div>
  {% if profile_summary.genres %}<div class="summary-line"><strong>Genres suggérés</strong> · {% for x in profile_summary.genres %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.moods %}<div class="summary-line"><strong>Ambiances</strong> · {% for x in profile_summary.moods %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.instrumentation %}<div class="summary-line"><strong>Instrumentation probable</strong> · {% for x in profile_summary.instrumentation %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.voice %}<div class="summary-line"><strong>Voix</strong> · {% for x in profile_summary.voice %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.audioset_contextual %}<div class="summary-line"><strong>Autres éléments sonores conservés dans l’ADN</strong> · {{ profile_summary.audioset_contextual|join(', ') }}</div>{% endif %}
  <div class="meta" style="margin-top:10px">{{ profile_summary.notice }}</div>
</div>
<style>
.profile-summary .summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:12px}.profile-summary .summary-grid>div{background:#f5f6f7;border:1px solid var(--line);border-radius:5px;padding:8px 10px}.profile-summary .summary-grid span{display:block;font-size:10px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.05em}.profile-summary .summary-grid strong{font-size:13px}.profile-summary .summary-line{font-size:12px;line-height:1.55;padding:4px 0}@media(max-width:900px){.profile-summary .summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
{% endif %}

{% if selected_profile_run.state == 'done' and profile_validation_subjects %}
<div class="card profile-human-validation">
  <div class="hero">
    <div>
      <h2>Validation humaine</h2>
      <div class="meta">
        Vérification musicale du run {{ selected_profile_run.public_id }}.
        Le formulaire valide les conclusions principales ; l’ADN conserve les données scientifiques et les scores d’origine.
        « Je ne sais pas » est une abstention humaine et n’est pas compté comme une erreur.
      </div>
    </div>
    <div class="meta">
      {{ profile_validation_stats.reviewed }} annoté(s) ·
      {{ profile_validation_stats.ok }} correct(s) ·
      {{ profile_validation_stats.ko }} incorrect(s) ·
      {{ profile_validation_stats.unknown }} sans avis
      {% if profile_validation_stats.accuracy is not null %}
        · précision sur avis connus {{ (profile_validation_stats.accuracy * 100)|number_format(1) }} %
      {% endif %}
    </div>
  </div>

  <form method="post"
        action="{{ path('profile_validate',{id:selected_profile_run.id}) }}"
        class="profile-human-validation-form">
    <table class="profile-validation-table">
      <thead>
        <tr>
          <th>Élément</th>
          <th>Proposition de l’analyse</th>
          <th>Votre avis</th>
          <th>Votre correction</th>
          <th>Degré de certitude</th>
          <th>Commentaire</th>
        </tr>
      </thead>
      <tbody>
      {% for subject in profile_validation_subjects %}
        {% set saved = profile_validations[subject.subject_key] ?? null %}

        {% set ui_label = {
          'tempo':'Tempo',
          'time_signature':'Mesure',
          'key':'Tonalité',
          'genre':'Genre',
          'instrumentation':'Instruments entendus',
          'voice':'Voix',
          'mood':'Ambiance',
          'audioset':'Éléments sonores remarquables',
          'choirs':'Chœurs / voix d’accompagnement'
        }[subject.item_key] ?? subject.label %}

        {% set ui_question = {
          'tempo':'Le tempo vous paraît-il correct ?',
          'time_signature':'La mesure vous paraît-elle correcte ?',
          'key':'La tonalité vous paraît-elle correcte ?',
          'genre':'Ce genre correspond-il bien au morceau ?',
          'instrumentation':'Ces instruments correspondent-ils à ce que vous entendez ?',
          'voice':'Cette description des voix vous paraît-elle correcte ?',
          'mood':'Cette ambiance correspond-elle au morceau ?',
          'audioset':'Ces éléments sonores vous paraissent-ils pertinents ?',
          'choirs':'Entendez-vous des chœurs ou des voix d’accompagnement ?'
        }[subject.item_key] ?? 'Cette proposition vous paraît-elle correcte ?' %}

        {% set ui_predicted = subject.predicted_text|replace({
          'singer-songwriter':'auteur-compositeur-interprète',
          'world music':'musiques du monde',
          'soft rock':'rock doux',
          'ballad':'ballade',
          'acoustic guitar':'guitare acoustique',
          'electric guitar':'guitare électrique',
          'bass guitar':'guitare basse',
          'acoustic bass':'contrebasse',
          'drum kit':'batterie',
          'snare drum':'caisse claire',
          'kick drum':'grosse caisse',
          'string section':'section de cordes',
          'brass section':'section de cuivres',
          'synthesizer':'synthétiseur',
          'keyboard (musical)':'clavier',
          'violin, fiddle':'violon',
          'violin':'violon',
          'cello':'violoncelle',
          'flute':'flûte',
          'clarinet':'clarinette',
          'ukulele':'ukulélé',
          'male lead vocal':'voix principale masculine',
          'female lead vocal':'voix principale féminine',
          'backing vocals':'voix d’accompagnement',
          'vocal harmonies':'harmonies vocales',
          'choir':'chœurs',
          'spoken voice':'voix parlée',
          'raspy singing voice':'voix chantée rauque',
          'vibrato singing':'chant avec vibrato',
          'powerful emotional singing':'chant puissant et expressif',
          'soft intimate singing':'chant doux et intimiste',
          'instrumental music with no vocals':'musique instrumentale sans voix',
          'vocal music':'musique vocale',
          'musical instrument':'instrument de musique',
          'singing':'chant',
          'speech':'parole',
          'reflective':'contemplatif',
          'intimate':'intimiste',
          'somber':'sombre',
          'passionate':'passionné',
          'mournful':'triste',
          'longing':'nostalgique',
          'dramatic':'dramatique',
          'romantic':'romantique',
          'melancholic':'mélancolique',
          'warm':'chaleureux',
          'dreamy':'rêveur',
          'nostalgic':'nostalgique',
          'tense':'tendu',
          'energetic':'énergique',
          'joyful':'joyeux',
          'peaceful':'paisible',
          'accepted':'retenu',
          'contextual':'contextuel',
          'generic':'générique',
          'uncertain':'incertain',
          'score':'indice'
        }) %}

        <tr>
          <td>
            <strong>{{ ui_label }}</strong>
            <div class="meta" style="margin-top:4px">{{ ui_question }}</div>
            <details style="margin-top:5px">
              <summary class="meta" style="cursor:pointer">Détails techniques</summary>
              <div class="meta">
                {{ subject.scope == 'gene' ? 'Gène' : 'Région' }}
                · {{ subject.subject_key }}
                {% if saved and saved.region_revision_ref %}
                  · {{ saved.region_revision_ref }}
                {% endif %}
                {% if saved and saved.gene_revision_ref %}
                  · {{ saved.gene_revision_ref }}
                {% endif %}
              </div>
            </details>
          </td>

          <td class="profile-machine-value">{{ ui_predicted }}</td>

          <td>
            <input type="hidden"
                   name="annotations[{{ loop.index0 }}][subject]"
                   value="{{ subject.subject_key }}">
            <div class="profile-verdicts" role="group" aria-label="Votre avis — {{ ui_label }}">
              <label>
                <input type="radio"
                       name="annotations[{{ loop.index0 }}][verdict]"
                       value="ok"
                       {{ saved and saved.verdict == 'ok' ? 'checked' : '' }}>
                Correct
              </label>
              <label>
                <input type="radio"
                       name="annotations[{{ loop.index0 }}][verdict]"
                       value="ko"
                       {{ saved and saved.verdict == 'ko' ? 'checked' : '' }}>
                Incorrect
              </label>
              <label>
                <input type="radio"
                       name="annotations[{{ loop.index0 }}][verdict]"
                       value="unknown"
                       {{ saved and saved.verdict == 'unknown' ? 'checked' : '' }}>
                Je ne sais pas
              </label>
            </div>
          </td>

          <td class="profile-human-truth">
            <input type="text"
                   name="annotations[{{ loop.index0 }}][human_value]"
                   value="{{ saved ? saved.human_value : '' }}"
                   placeholder="Valeur correcte si la proposition est incorrecte"
                   maxlength="500">

            {% if subject.item_key in ['instrumentation','voice','audioset','choirs'] %}
            <input type="text"
                   name="annotations[{{ loop.index0 }}][missing_expected]"
                   value="{{ saved ? saved.missing_expected_text : '' }}"
                   placeholder="Éléments entendus mais absents, séparés par ;"
                   maxlength="1000">
            {% endif %}
          </td>

          <td>
            <select name="annotations[{{ loop.index0 }}][reviewer_certainty]">
              <option value="" {{ not saved or not saved.reviewer_certainty ? 'selected' : '' }}>—</option>
              <option value="certain" {{ saved and saved.reviewer_certainty == 'certain' ? 'selected' : '' }}>Certain</option>
              <option value="probable" {{ saved and saved.reviewer_certainty == 'probable' ? 'selected' : '' }}>Probable</option>
              <option value="uncertain" {{ saved and saved.reviewer_certainty == 'uncertain' ? 'selected' : '' }}>Incertain</option>
            </select>
          </td>

          <td>
            <input type="text"
                   name="annotations[{{ loop.index0 }}][comment]"
                   value="{{ saved ? saved.comment : '' }}"
                   placeholder="Précision utile (facultatif)"
                   maxlength="2000">
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

    <div style="margin-top:12px">
      <button type="submit">Enregistrer les annotations</button>
      <span class="meta">Les lignes sans avis sélectionné ne sont pas modifiées.</span>
    </div>
  </form>
</div>
{% endif %}
{% set pv = selected_profile_run.diagnostics.profile_view ?? {} %}
{% set pc = pv.counts ?? {} %}
{% set legacy_gene_key = 'ped' ~ 'als' %}
{% set genes = pv.genes is defined ? pv.genes : (attribute(pv, legacy_gene_key) ?? []) %}
{% set pi = pv.instrumentation ?? {} %}
<div class="card">
  <h2>Instruments détectés</h2>
  <div class="meta">Résultat expérimental sur le mix complet. Il ne pilote pas encore STEMS.</div>
  {% if pi.candidates is defined and pi.candidates %}
    <div style="margin-top:8px">
    {% for x in pi.candidates %}
      <span class="badge ok" style="margin:0 5px 5px 0">{{ x.label }} · {{ x.support }}/3 moteurs</span>
    {% endfor %}
    </div>
  {% else %}
    <p>Aucun instrument n’est suffisamment confirmé pour l’instant.</p>
  {% endif %}
  {% if pi.weak is defined and pi.weak %}
    <details style="margin-top:8px"><summary>Hypothèses plus faibles</summary>
      <div class="meta" style="margin-top:6px">{% for x in pi.weak|slice(0,10) %}{{ x.label }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    </details>
  {% endif %}
</div>

{% set choir = pv.choirs ?? {} %}
<div class="card">
  <h2>Chœurs / voix d’accompagnement</h2>
  {% if choir.decision is defined and choir.decision == 'detected' %}
    <p><strong>Chœurs détectés</strong></p>
    <div class="meta">Plusieurs analyses vont dans le même sens. À confirmer avec votre écoute.</div>
  {% elseif choir.decision is defined and choir.decision == 'possible' %}
    <p><strong>Chœurs possibles</strong></p>
    <div class="meta">Il y a des indices, mais PROFILE préfère rester prudent.</div>
  {% else %}
    <p><strong>Pas de conclusion fiable</strong></p>
    <div class="meta">PROFILE s’abstient plutôt que d’affirmer qu’il n’y a pas de chœurs.</div>
  {% endif %}
</div>

<div class="card">
  <h2>Gènes PROFILE</h2>
  <div class="meta">{{ pc.ok ?? 0 }} gène(s) OK · {{ pc.skipped ?? 0 }} ignoré(s) · {{ pc.error ?? 0 }} en erreur</div>
  {% if genes %}
  <table><thead><tr><th>Gène</th><th>Famille</th><th>État</th><th>Device</th><th>Temps</th></tr></thead><tbody>
  {% for e in genes %}
    <tr>
      <td>{{ e.name ?? e.id }}{% if e.error %}<div class="meta">{{ e.error }}</div>{% endif %}</td>
      <td>{{ e.family ?? '—' }}</td>
      <td><span class="badge {{ e.status == 'ok' ? 'ok' : (e.status == 'error' ? 'warn' : '') }}">{{ e.status }}</span></td>
      <td>{{ e.device ?? '—' }}</td>
      <td>{% if e.elapsed_seconds is not null %}{{ e.elapsed_seconds|number_format(2) }} s{% else %}—{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% endif %}
</div>

{% if pv.tonal is defined and pv.tonal.label is defined %}
<div class="card"><h2>Consensus tonal</h2>
  <div><strong>{{ pv.tonal.label }}</strong> · support {{ pv.tonal.support ?? 0 }}/{{ pv.tonal.sources|length }}</div>
  <table><thead><tr><th>Gène</th><th>Tonalité</th><th>Confiance source</th></tr></thead><tbody>
  {% for s in pv.tonal.sources ?? [] %}
    {% set legacy_source_key = 'ped' ~ 'al' %}
    <tr><td>{{ s.gene ?? attribute(s, legacy_source_key) ?? '—' }}</td><td>{{ s.label }}</td><td>{% if s.confidence is not null %}{{ (s.confidence*100)|number_format(1) }}%{% else %}—{% endif %}</td></tr>
  {% endfor %}
  </tbody></table>
</div>
{% endif %}

{% if pv.audioset is defined and pv.audioset.agreements is defined %}
<div class="card"><h2>Consensus AudioSet · PANNs / PaSST</h2>
  <div class="meta">Confidence opérationnelle non calibrée : décroissance exponentielle du rang absolu + persistance temporelle top-5/top-10, puis minimum entre PANNs et PaSST. Seuil de décision 60 %. Les labels génériques restent visibles mais ne sont pas retenus. Ce pourcentage n'est pas une probabilité calibrée.</div>
  {% if pv.audioset.agreements %}
  <table><thead><tr><th>Label</th><th>Support</th><th>Scores source</th><th>Confidence</th><th>Stabilité</th><th>Décision</th></tr></thead><tbody>
  {% for a in pv.audioset.agreements %}
    <tr>
      <td>{{ a.label }}</td>
      <td>{{ a.support }}</td>
      <td>{% for s in a.sources ?? [] %}{% set legacy_source_key = 'ped' ~ 'al' %}{{ s.gene ?? attribute(s, legacy_source_key) ?? '—' }}={{ (s.score*100)|number_format(1) }}%{% if not loop.last %} · {% endif %}{% endfor %}</td>
      <td>{% if a.confidence is defined and a.confidence is not null %}{{ (a.confidence*100)|number_format(1) }}%{% else %}—{% endif %}</td>
      <td>
        {% if a.source_evidence is defined and a.source_evidence %}
          {% for e in a.source_evidence %}
            {{ e.gene }} : rang {{ e.rank ?? '—' }}/{{ e.class_count ?? '—' }}, rang-score {% if e.rank_score is defined %}{{ (e.rank_score*100)|number_format(0) }}%{% else %}—{% endif %}, top-5 {% if e.top5_support is defined %}{{ (e.top5_support*100)|number_format(0) }}%{% else %}—{% endif %}, top-10 {{ (e.top10_support*100)|number_format(0) }}%{% if not loop.last %}<br>{% endif %}
          {% endfor %}
        {% elseif a.temporal_support_min is defined and a.temporal_support_min is not null %}
          {{ (a.temporal_support_min*100)|number_format(0) }}%
        {% else %}
          —
        {% endif %}
      </td>
      <td>
        {% if a.decision is defined and a.decision == 'accepted' %}
          <span class="badge ok">retenu</span>
        {% elseif a.decision is defined and a.decision == 'contextual' %}
          <span class="badge">contextuel</span>
        {% elseif a.decision is defined and a.decision == 'generic' %}
          <span class="badge">générique</span>
        {% elseif a.decision is defined %}
          <span class="badge">incertain</span>
        {% else %}
          —
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% else %}<p class="meta">Aucun label commun entre moteurs.</p>{% endif %}
</div>
{% endif %}

{% if pv.embeddings is defined and pv.embeddings %}
<div class="card"><h2>Embeddings MERT</h2>
<table><thead><tr><th>Gène</th><th>État</th><th>Dimension</th><th>Chunks</th><th>Norme</th><th>Variation temporelle</th></tr></thead><tbody>
{% for e in pv.embeddings %}
<tr><td>{{ e.name }}</td><td>{{ e.status }}</td><td>{{ e.hidden_size ?? '—' }}</td><td>{{ e.chunk_count ?? '—' }}</td><td>{{ e.embedding_norm ?? '—' }}</td><td>{{ e.temporal_std_mean ?? '—' }}</td></tr>
{% endfor %}
</tbody></table>
</div>
{% endif %}

<div class="card"><div class="meta">Moteur sémantique : {{ t.backend ?? 'indisponible' }}{% if t.model is defined %} · {{ t.model }}{% endif %}. Les scores CLAP sont relatifs à la taxonomie comparée, pas des probabilités calibrées.</div></div>
<div class="card"><h2>Genre</h2>{% if t.available ?? false %}<table><thead><tr><th>Tag</th><th>Score</th></tr></thead><tbody>{% for x in t.genre ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Analyse du genre indisponible.</p>{% endif %}</div>
<div class="card"><h2>Instrumentation probable</h2>{% if t.available ?? false %}<table><thead><tr><th>Instrument</th><th>Score</th></tr></thead><tbody>{% for x in t.instrumentation ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur instrument non disponible.</p>{% endif %}</div>
<div class="card"><h2>Voix</h2>{% if t.available ?? false %}<table><thead><tr><th>Caractéristique</th><th>Score</th></tr></thead><tbody>{% for x in t.voice ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur vocal non disponible.</p>{% endif %}</div>
<div class="card"><h2>Ambiance / mood</h2>{% if t.available ?? false %}<table><thead><tr><th>Tag</th><th>Score</th></tr></thead><tbody>{% for x in t.mood ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur mood non disponible.</p>{% endif %}</div>
<div class="card"><a class="button secondary" href="{{ path('dna_run',{id:selected_profile_run.id}) }}">Run PROFILE</a> <a class="button" href="{{ path('workbench_stems',{song:selected_song.id}) }}">Ouvrir STEMS</a> <span class="meta">Navigation uniquement.</span></div>
{% if profile_active %}
<div data-profile-live-refresh="1" hidden></div>
<script>
(() => {
  const marker = document.querySelector('[data-profile-live-refresh="1"]');
  if (!marker || window.__ezstudioProfileLiveRefresh) return;
  window.__ezstudioProfileLiveRefresh = true;

  let stopped = false;

  async function refreshProfileContent() {
    if (stopped) return;

    try {
      const response = await fetch(window.location.href, {
        cache: 'no-store',
        headers: {'Accept': 'text/html'}
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextWrap = doc.querySelector('.wrap');
      const currentWrap = document.querySelector('.wrap');

      if (!nextWrap || !currentWrap) {
        throw new Error('profile_wrap_missing');
      }

      const stillActive = !!nextWrap.querySelector('[data-profile-live-refresh="1"]');
      currentWrap.innerHTML = nextWrap.innerHTML;

      if (stillActive) {
        window.setTimeout(refreshProfileContent, 2500);
      } else {
        stopped = true;
        window.__ezstudioProfileLiveRefresh = false;
      }
    } catch (error) {
      window.setTimeout(refreshProfileContent, 2500);
    }
  }

  window.addEventListener('pagehide', () => { stopped = true; }, {once:true});
  window.setTimeout(refreshProfileContent, 2500);
})();
</script>
