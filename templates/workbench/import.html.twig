{% extends 'base.html.twig' %}
{% block title %}Import · EZStudio_lab{% endblock %}
{% block body %}
<div class="card hero"><div><h1>IMPORT</h1><div class="meta">Ajouter une source au laboratoire.</div></div></div>
<div class="card">
<form action="{{ path('workbench_import_source') }}" method="post" enctype="multipart/form-data">
<div class="row">
<label>Audio<input type="file" name="audio" accept="audio/*,.mp3,.wav,.flac,.ogg,.m4a,.aac" required></label>
<label>Titre<input name="title"></label>
<label>Artiste<input name="artist"></label>
<button type="submit">Importer</button><span class="meta">Import uniquement. PROFILE, STEMS et CHORDS restent manuels.</span>
</div>
</form>
</div>
{% endblock %}
