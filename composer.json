{
  "name": "ezstudio/lab",
  "description": "Autonomous and extensible audio-analysis laboratory for STEMS, CHORDS and LYRICS research",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "symfony/console": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "symfony/debug-bundle": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  }
}
